{
  "name": "shopassistant-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:view": "npm --prefix ../view run build",
    "deploy": "npm run build:view && wrangler deploy",
    "db:init": "wrangler d1 execute zero-1-base --file=store/migrations/0001_init.sql --remote",
    "db:seed": "wrangler d1 execute zero-1-base --file=store/migrations/0002_seed.sql --remote",
    "db:events": "wrangler d1 execute zero-1-base --file=store/migrations/0003_order_events.sql --remote",
    "db:i18n": "wrangler d1 execute zero-1-base --file=store/migrations/0004_product_i18n.sql --remote",
    "db:interventions": "wrangler d1 execute zero-1-base --file=store/migrations/0006_intervention_behavior.sql --remote",
    "db:ai-safety": "wrangler d1 execute zero-1-base --file=store/migrations/0007_ai_conversation_safety.sql --remote",
    "db:product-chat-history": "wrangler d1 execute zero-1-base --file=store/migrations/0008_product_chat_history.sql --remote",
    "db:add-products": "wrangler d1 execute zero-1-base --file=store/migrations/0009_add_more_products.sql --remote",
    "db:more-product-i18n": "wrangler d1 execute zero-1-base --file=store/migrations/0010_more_product_i18n.sql --remote",
    "db:add-27-products": "wrangler d1 execute zero-1-base --file=store/migrations/0011_add_27_products.sql --remote",
    "db:add-product-type-depth": "wrangler d1 execute zero-1-base --file=store/migrations/0012_add_product_type_depth.sql --remote",
    "db:archive-research": "wrangler d1 execute zero-1-base --file=store/migrations/0013_completed_research_archives.sql --remote",
    "db:archive-research-content": "wrangler d1 execute zero-1-base --file=store/migrations/0014_completed_research_archive_content.sql --remote"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
